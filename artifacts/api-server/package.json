{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "reminders:send": "node --enable-source-maps ./dist/reminders.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:access": "node --test tests/platform-access.test.mjs",
    "test:sections": "node --test tests/admin-sections.test.mjs tests/section-course-completion.test.mjs",
    "test:security": "node --test tests/platform-access.test.mjs tests/language-security.test.mjs tests/admin-sections.test.mjs tests/section-course-completion.test.mjs tests/academy-study.test.mjs",
    "test:ads": "node --test tests/ads.test.mjs"
  },
  "dependencies": {
    "@clerk/express": "^2.1.83",
    "@clerk/shared": "^4.41.1",
    "@google-cloud/storage": "^8.4.0",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "@workspace/integrations-openai-ai-server": "workspace:*",
    "@workspace/language-content": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.3.0",
    "http-proxy-middleware": "^4.2.1",
    "mammoth": "1.13.0",
    "pdf-parse": "2.4.5",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "@types/web-push": "^3.6.4",
    "esbuild": "0.28.2",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.2.0",
    "thread-stream": "3.1.0"
  }
}
